{
  "name": "map-point-cloud",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:map": "pnpm --filter point-cloud-map dev",
    "dev:ascii": "pnpm --filter ascii-video dev",
    "build": "pnpm --filter point-cloud-map build && pnpm --filter ascii-video build",
    "predeploy": "pnpm build",
    "deploy": "gh-pages -d dist",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^5.0.0",
    "globals": "^16.5.0"
  }
}
